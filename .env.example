# A论 环境变量示例（复制为 .env 或在启动前设置）
ALUN_AUTH_MODE=strict
ALUN_AUTH_SECRET=change-me-in-production
ALUN_ADMIN_USERNAME=admin
ALUN_ADMIN_PASSWORD=admin123
ALUN_DEMO_USERNAME=demo
ALUN_DEMO_PASSWORD=demo123
ALUN_DATA_DIR=./data
ALUN_MAX_UPLOAD_MB=100

# OpenAI 兼容模型网关
ALUN_LLM_BASE_URL=http://127.0.0.1:7863/v1
ALUN_LLM_API_KEY=
ALUN_LLM_MODEL=cn:deepseek-v4-flash
ALUN_LLM_FALLBACK_MODEL=cn:glm-5.3-flash
ALUN_ENABLE_LLM=1
ALUN_LLM_TIMEOUT=90

# V2.0 平台模式见 .env.platform.example
# ALUN_DB_BACKEND=postgres
# ALUN_DATABASE_URL=postgresql://alun:...@127.0.0.1:55432/alun
# ALUN_REDIS_URL=redis://:...@127.0.0.1:6379/1
# ALUN_QUEUE_BACKEND=redis
# ALUN_S3_ENDPOINT=http://127.0.0.1:9000
