# A论 V2.0 平台化环境变量（复制为 .env 或启动前导入）
# 单机默认仍是 SQLite；以下配置启用 PostgreSQL/pgvector + Redis + MinIO + 队列。

ALUN_DB_BACKEND=postgres
ALUN_DATABASE_URL=postgresql://alun:alun_dev_password@127.0.0.1:55432/alun

# 本机 Redis 服务（已运行，密码 123456）或 compose 的 6380 端口
ALUN_REDIS_URL=redis://:123456@127.0.0.1:6379/1
ALUN_QUEUE_BACKEND=redis

ALUN_S3_ENDPOINT=http://127.0.0.1:9000
ALUN_S3_ACCESS_KEY=alun
ALUN_S3_SECRET_KEY=alun_dev_password
ALUN_S3_BUCKET=alun-documents

ALUN_LOG_JSON=1
ALUN_SECURITY_HEADERS=1
ALUN_CORS_ORIGINS=http://127.0.0.1:8010,http://127.0.0.1:8011

# 生产必须替换
ALUN_AUTH_SECRET=replace-with-a-long-random-secret
ALUN_ADMIN_PASSWORD=replace-me
ALUN_TEACHER_PASSWORD=replace-me
ALUN_DEMO_PASSWORD=replace-me
